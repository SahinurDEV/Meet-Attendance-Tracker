{
  "name": "meet-attendance-tracker",
  "version": "2.1.0",
  "private": true,
  "description": "Privacy-first Google Meet attendance tracker Chrome extension (Manifest V3). All data stays on your device.",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/unit/",
    "test:integration": "node --test --test-concurrency=1 test/integration/",
    "test:setup": "playwright install chromium",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/build-icons.mjs",
    "lint:manifest": "node scripts/check-manifest.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  }
}
