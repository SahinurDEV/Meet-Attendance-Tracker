{
  "name": "meet-attendance-tracker",
  "version": "2.1.1",
  "private": true,
  "description": "Privacy-first Google Meet attendance tracker Chrome extension (Manifest V3). All data stays on your device.",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-tests.mjs test/unit",
    "test:integration": "node scripts/run-tests.mjs test/integration --test-concurrency=1",
    "test:setup": "playwright install chromium",
    "lint": "eslint .",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/build-icons.mjs",
    "lint:manifest": "node scripts/check-manifest.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SahinurDEV/Meet-Attendance-Tracker.git"
  },
  "homepage": "https://sahinurdev.github.io/Meet-Attendance-Tracker/",
  "bugs": {
    "url": "https://github.com/SahinurDEV/Meet-Attendance-Tracker/issues"
  },
  "author": "Sahinur (SahinurDEV) (https://github.com/SahinurDEV)"
}
